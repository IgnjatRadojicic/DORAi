# Copy to .env next to compose.yaml and fill in. Never commit .env.
# Settings the server does not read yet are marked "later": they are reserved names, so the
# deployment does not change when that phase lands.

# Image tag to run (a release such as 1.0.0, or latest).
DORAI_VERSION=latest

# Address the apps use; it goes into invite links (later).
DORAI_PUBLIC_URL=https://dorai.firm.local:8443
DORAI_HTTPS_PORT=8443
DORAI_HTTP_PORT=8080

# Database. Pick a long random password.
DORAI_DB_USER=dorai
DORAI_DB_PASSWORD=

# Signing key for access tokens: a long random string (later).
DORAI_JWT_SECRET=
# Password for the generated TLS keystore (later).
DORAI_TLS_KEYSTORE_PASSWORD=

# fixtures or live (later): live scans the firm's cloud with the credentials below.
DORAI_DATA_SOURCE=fixtures
# fake or real (later): real calls the configured LLM through Koog.
DORAI_AI=fake

# Azure collector (later), standard Azure SDK variables for a read-only service principal.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# AWS collector (later), standard AWS SDK variables for a read-only IAM user or role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1

# Backups: daily time (24h, in DORAI_TIMEZONE), days to keep, host folder.
DORAI_BACKUP_TIME=02:00
DORAI_BACKUP_KEEP_DAYS=14
DORAI_BACKUP_DIR=./backups
DORAI_TIMEZONE=UTC
