# Copy to .env next to compose.yaml and fill in. Never commit .env.
# Settings the server does not read yet are marked "later": they are reserved names, so the
# deployment does not change when that phase lands.

# Image tag to run (a release such as 1.0.0, or latest).
DORAI_VERSION=latest

# Address the apps use; it goes into invite links and the certificate.
DORAI_PUBLIC_URL=https://dorai.firm.local:8443
DORAI_HTTPS_PORT=8443
DORAI_HTTP_PORT=8080

# none (default): the apps reach this host directly and invite links pin its own certificate.
# cloudflare: the apps reach it through a Cloudflare Tunnel. Then set DORAI_PUBLIC_URL to the tunnel's
# https address (no port), point the tunnel at http://127.0.0.1:${DORAI_HTTP_PORT}, and set
# DORAI_HTTPS_BIND=127.0.0.1 so port 8443 is not open to anyone. See docs/deploy.md.
# DORAI_PROXY=none
# DORAI_HTTPS_BIND=0.0.0.0

# Database. Pick a long random password.
DORAI_DB_USER=dorai
DORAI_DB_PASSWORD=

# Signing key for access tokens: a long random string, at least 32 characters.
DORAI_JWT_SECRET=
# Password for the TLS keystore the server generates on its first start.
DORAI_TLS_KEYSTORE_PASSWORD=
# Name of the admin created on the first start (default admin).
# DORAI_ADMIN_USERNAME=admin

# fixtures or live: live scans the firm's cloud with the credentials below.
DORAI_DATA_SOURCE=fixtures
# Background scan interval (at least 1h), for example 24h; leave empty for scans from the app only.
DORAI_SCAN_EVERY=
# AI: fake (default, offline, no key) or openai (OpenAI or an OpenAI-compatible endpoint through Koog).
DORAI_AI_PROVIDER=fake
# For openai: the API key, and optionally another endpoint and chat model.
# DORAI_AI_OPENAI_KEY=
# DORAI_AI_OPENAI_BASE_URL=
# DORAI_AI_CHAT_MODEL=gpt-4.1-mini
# Minimum similarity for a regulation passage to be cited (default 0.40 for openai, 0.25 for fake).
# DORAI_AI_MIN_SIMILARITY=0.40
# Load the regulation texts in the background on start (default true; already loaded texts are skipped).
# DORAI_AI_INGEST_ON_STARTUP=true

# Live scan. Which clouds to scan (default azure,aws).
# DORAI_CLOUDS=azure,aws
# Cost is shown in this currency; set a fixed rate for every other currency your clouds bill in
# (units of DORAI_COST_CURRENCY per one unit). Rows in a currency without a rate are left out.
# DORAI_COST_CURRENCY=EUR
# DORAI_FX_USD=0.92

# Azure: standard Azure SDK variables for a read-only service principal
# (Reader for the scan, Cost Management Reader for cost).
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# Optional: limit the scan (default: every subscription the principal can read).
# DORAI_AZURE_SUBSCRIPTIONS=
# DORAI_AZURE_RESOURCE_GROUP=

# AWS: standard AWS SDK variables for a read-only IAM user or role
# (tag:GetResources for the scan, ce:GetCostAndUsageWithResources for cost).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
# Regions to scan (default AWS_REGION).
# DORAI_AWS_REGIONS=eu-central-1,eu-west-1

# Backups: daily time (24h, in DORAI_TIMEZONE), days to keep, host folder.
DORAI_BACKUP_TIME=02:00
DORAI_BACKUP_KEEP_DAYS=14
DORAI_BACKUP_DIR=./backups
DORAI_TIMEZONE=UTC
